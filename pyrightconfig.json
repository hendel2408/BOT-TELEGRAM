{
  "include": [
    "backend/app.py",
    "backend/main.py",
    "backend/src"
  ],
  "exclude": [
    "**/node_modules",
    "**/.git",
    "**/.venv",
    "**/typings",
    "**/__pycache__",
    "backend/data",
    "scripts",
    "frontend",
    "frontend/dist",
    "frontend/.vite",
    "venv"
  ],
  "venvPath": ".",
  "venv": "venv",
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        "backend/src"
      ]
    }
  ]
}
